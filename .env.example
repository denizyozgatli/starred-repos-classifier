# ------------------------------------------------------------
# CLI-only configuration (npm run cli / pipeline scripts).
# The web dashboard does NOT read this file: it asks for the
# token in the UI and stores it in the browser.
# ------------------------------------------------------------
# Optional: default GitHub username for the CLI
GITHUB_USERNAME=your-username
# Optional: token used by the CLI (fine-grained with Starring: Read-only, or classic ghp_)
GITHUB_TOKEN=your_github_token_here
# Optional: LLM provider for fallback classification in the CLI (openai | anthropic | google | deepseek)
LLM_PROVIDER=google
# Optional: API key for the chosen LLM provider (GEMINI_API_KEY still works for LLM_PROVIDER=google)
LLM_API_KEY=your_llm_api_key_here
# Optional: Model override (defaults: gpt-6-luna, claude-sonnet-5-5, gemini-3.8-flash, deepseek-chat)
# LLM_MODEL=
# Optional: Request interval in seconds (defaults: 1 for openai/anthropic/deepseek, 4 for google)
# LLM_INTERVAL_SEC=
