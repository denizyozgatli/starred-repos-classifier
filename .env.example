# ------------------------------------------------------------
# CLI-only configuration (npm run cli / pipeline scripts).
# The web dashboard does NOT read this file: it asks for the
# token in the UI and stores it in the browser.
# ------------------------------------------------------------
# Optional: default GitHub username for the CLI
GITHUB_USERNAME=your-username
# Optional: token used by the CLI (fine-grained with Starring: Read-only, or classic ghp_)
GITHUB_TOKEN=your_github_token_here
# Optional: Gemini API key for LLM fallback classification in the CLI
GEMINI_API_KEY=your_gemini_api_key_here
